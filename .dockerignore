# Ignore everything first
*

# Allow only what builds need
!stopsign/
!config/
!static/
!scripts/
!rtsp_to_redis/
!pyproject.toml
!docker/
!docker/production/
!docker/production/entrypoint.sh
!uv.lock

# Always exclude these even from allowed dirs
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/*.log
**/models/
**/scratch/
